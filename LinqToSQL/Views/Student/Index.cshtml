<!-- Declare the type of data this view expects -->
@model IEnumerable<LinqToSQL.Models.Student>

<h2>Employee List</h2>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Gender</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Student stu in Model)
        {
            <tr>
                <td>@stu.id</td>
                <td>@stu.name</td>
                <td>@stu.gender</td>
            </tr>
        }
    </tbody>
</table>
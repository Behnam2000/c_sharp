<!-- Declare the type of data this view expects -->
@model IEnumerable<LinqToSQL.Models.Student>

<h2>Student List</h2>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Gender</th>
            <th>University</th>
            <th>Lectures</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Student stu in Model)
        {
            <tr>
                <td>@stu.Id</td>
                <td>@stu.Name</td>
                <td>@stu.Gender</td>
                <td>
                    @* Display the University Name, or "N/A" if null  *@
                    @(stu.University != null ? stu.University.Name : "N/A")
                </td>

                <td>
                    @if (stu.StudentLectures != null && stu.StudentLectures.Any())
                    {
                        @* Extract just the lecture names and join them with a comma *@
                        var lectureNames = stu.StudentLectures.Select(sl => sl.Lecture.Name);
                        @string.Join(", ", lectureNames)


                    }
                    else
                    {
                        <span style="color: gray;">None</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>